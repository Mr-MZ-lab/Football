# Database
DATABASE_URL=postgresql://football_user:football_pass@localhost:5432/football_db

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys (optional - system uses mock data if not provided)
SOFASCORE_API_KEY=your_sofascore_api_key
OPTA_API_KEY=your_opta_api_key

# App settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Model settings
MODEL_PATH=./saved_models
MIN_TRAINING_SAMPLES=50
RETRAIN_INTERVAL_HOURS=24
