# Database
DATABASE_URL=postgresql://football_user:football_pass@localhost:5432/football_db

# Redis
REDIS_URL=redis://localhost:6379/0

# ── Real data API keys (optional — system works without them via mock data) ───

# football-data.org — free match schedule + results for Bundesliga, PL, etc.
# Register free at: https://www.football-data.org/client/register
# Provides: today's fixtures, live scores, standings
FOOTBALL_DATA_API_KEY=

# The Odds API — real bookmaker odds (Tipico, Bwin, Betano, Bet365, etc.)
# Register free at: https://the-odds-api.com/ (500 req/month on free tier)
# Provides: 1X2, Over/Under, BTTS odds from German bookmakers
ODDS_API_KEY=

# App settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Model settings
MODEL_PATH=./saved_models
MIN_TRAINING_SAMPLES=50
RETRAIN_INTERVAL_HOURS=24
